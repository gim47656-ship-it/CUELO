{
  "name": "cuelo",
  "version": "0.5.1",
  "description": "CUELO — open-source AI coding agent workspace and harness for omp (oh-my-pi)",
  "homepage": "https://github.com/gim47656-ship-it/CUELO#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gim47656-ship-it/CUELO.git"
  },
  "bugs": {
    "url": "https://github.com/gim47656-ship-it/CUELO/issues"
  },
  "keywords": [
    "cuelo",
    "omp",
    "oh-my-pi",
    "ai-coding",
    "coding-agent",
    "ai-agent",
    "agent-harness",
    "agent-orchestration",
    "multi-agent",
    "model-routing",
    "developer-tools",
    "typescript",
    "bun",
    "nextjs",
    "pwa"
  ],
  "license": "MIT",
  "cueloBuild": {
    "distribution": "cuelo",
    "coreVersion": "18.3.2"
  },
  "engines": {
    "node": ">=22.19.0",
    "bun": ">=1.4.2"
  },
  "bin": {
    "cuelo": "bin/cuelo.js"
  },
  "files": [
    "bin",
    ".next",
    "!.next/cache",
    "!.next/dev",
    "!.next/_events_*",
    "!.next/**/*.js.map",
    "public",
    "install.mjs",
    "Tools/CUELO_Setup/files/native-runtime-patch.js",
    "Tools/CUELO_Setup/files/usage-server.js",
    "Tools/CUELO_Setup/files/btw-server.js",
    "Tools/CUELO_Setup/files/subagent-server.js",
    "Tools/OMP_Global_Config/patches/apply-core-patch.mjs",
    "Tools/OMP_Global_Config/patches/apply-notices.mjs",
    "Tools/OMP_Global_Config/notices/ultrathink.md",
    "Tools/OMP_Global_Config/notices/orchestrate.md",
    "Tools/OMP_Global_Config/notices/workflow.md",
    "Tools/OMP_Global_Config/agent/AGENTS.md",
    "Tools/OMP_Global_Config/agent/RULES.md",
    "Tools/OMP_Global_Config/agent/WATCHDOG.md",
    "Tools/OMP_Global_Config/agent/agents",
    "Tools/OMP_Global_Config/agent/extensions",
    "Tools/OMP_Global_Config/agent/prompt-copies",
    "Tools/OMP_Global_Config/agent/rules",
    "Tools/OMP_Global_Config/agent/sop",
    "Tools/OMP_Global_Config/agent/tools",
    "!Tools/OMP_Global_Config/agent/**/tests",
    "!Tools/OMP_Global_Config/agent/**/*.test.*",
    "!public/**/*.test.mjs",
    "next.config.ts",
    "package.json"
  ],
  "scripts": {
    "postinstall": "node bin/prepare-runtime.js",
    "prepare:runtime": "node bin/prepare-runtime.js",
    "dev": "bun --bun next dev --webpack -H 127.0.0.1 -p 30141",
    "dev:lan": "bun --bun next dev --webpack -H 0.0.0.0 -p 30141",
    "build": "bun --bun next build --webpack",
    "start": "bun bin/cuelo.js --no-open -H 127.0.0.1 -p 30141",
    "start:lan": "bun bin/cuelo.js --no-open -H 0.0.0.0 -p 30141",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./app ./components ./hooks ./lib ./public ./bin",
    "test:coverage": "bun test --coverage ./app ./components ./hooks ./lib ./public ./bin"
  },
  "dependencies": {
    "@oh-my-pi/pi-agent-core": "18.3.2",
    "@oh-my-pi/pi-ai": "18.3.2",
    "@oh-my-pi/pi-coding-agent": "18.3.2",
    "@oh-my-pi/pi-tui": "18.3.2",
    "@oh-my-pi/pi-utils": "18.3.2",
    "@seed-design/css": "2.8.0",
    "@seed-design/react": "2.4.1",
    "@seed-design/tailwind4-theme": "2.4.0",
    "js-yaml": "^5.4.1",
    "next": "16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark-frontmatter": "^5.0.0",
    "unpdf": "1.8.1",
    "yaml": "^2.9.0"
  },
  "optionalDependencies": {
    "onnxruntime-node": "1.21.0"
  },
  "devDependencies": {
    "@lobehub/icons": "^5.16.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/react-syntax-highlighter": "^15.5.13",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "jiti": "^2.7.0",
    "katex": "^0.16.47",
    "mammoth": "^1.12.2",
    "mermaid": "^11.17.2",
    "postcss": "^8.5.26",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
