# The deploy pipeline hashes bun.lock byte-for-byte against the committed (LF) blob.
# With core.autocrlf=true a CRLF checkout breaks that check ("frozen install 뒤 bun.lock
# SHA-256이 변경되었다"), so the lockfile is always checked out with LF.
bun.lock text eol=lf

# WSL entrypoints are also invoked from the Windows checkout.
Tools/CUELO_Setup/wsl/**/*.sh text eol=lf

# bin/prepare-upkeep-reader.js hashes these bytes to match a native binary to its source; a CRLF
# checkout on Windows would make every published asset look like it came from other source.
native/upkeep-reader/** text eol=lf

# Several sessions append memory rows in their own worktrees. git_integrate rebases them onto
# main; union keeps both sides' rows instead of stopping on a text conflict (memory-sync's
# import tolerates the duplicate keys this can leave).
Tools/OMP_Global_Config/memory-sync/memories.jsonl merge=union
